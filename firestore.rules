rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Verifica que o payload não tem campos além dos esperados
    function appStateHasValidKeys() {
      return request.resource.data.keys().hasOnly([
        'bankrollName', 'currency', 'startingBalance', 'lastModifiedAt',
        'riskSettings', 'bookmakers', 'strategies', 'bets', 'transactions',
        'betTemplates', 'reportSnapshots',
        'updatedAt', 'schemaVersion'
      ]);
    }

    // Impede que lastModifiedAt regride (proteção contra sobrescrita antiga)
    function timestampNotRegressed() {
      return !('lastModifiedAt' in resource.data) ||
             resource.data.lastModifiedAt == null ||
             !('lastModifiedAt' in request.resource.data) ||
             request.resource.data.lastModifiedAt == null ||
             request.resource.data.lastModifiedAt >= resource.data.lastModifiedAt;
    }

    // ── Estado principal do app ───────────────────────────────────────────────

    match /users/{userId}/appStates/{stateId} {
      allow read: if owns(userId);
      allow create: if owns(userId) && appStateHasValidKeys();
      allow update: if owns(userId) && appStateHasValidKeys() && timestampNotRegressed();
      allow delete: if false; // Estado nunca é apagado, apenas sobrescrito
    }

    // ── Audit logs — append-only ──────────────────────────────────────────────

    match /users/{userId}/auditLogs/{logId} {
      allow read: if owns(userId);
      allow create: if owns(userId);
      allow update, delete: if false; // Imutável após criação
    }

    // ── Entitlements (plano do usuário) — leitura do dono, escrita só backend ──

    match /entitlements/{userId} {
      allow read: if owns(userId);
      allow write: if false; // Só o Admin SDK (webhook do Mercado Pago) escreve
    }

    // ── Lista de espera (waitlist) — create-only público, validado ────────────

    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'plan', 'createdAt', 'userAgent'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
                    && request.resource.data.plan is string
                    && request.resource.data.plan.size() <= 60
                    && (!('userAgent' in request.resource.data) ||
                        (request.resource.data.userAgent is string &&
                         request.resource.data.userAgent.size() <= 512));
      allow read, update, delete: if false; // Leitura só pelo Console/Admin
    }

    // ── Fallback — nega tudo o que não foi explicitamente permitido ───────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
